+        if not result["success"]:
+            self.log(f"❌ Failed to assign sequence to webhook lead: {result['error']}", "ERROR")
+            return False
+        
+        # Simulate Twilio webhook (form data)
+        webhook_data = {
+            "From": "+15557776666",
