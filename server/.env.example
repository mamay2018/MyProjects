# ====================================
# FollowUp Pro - Server Environment
# ====================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://followup_user:followup_pass@localhost:5432/followup_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Twilio (SMS)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# SendGrid (Email)
# Get API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# Stripe (Subscriptions)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# OpenAI (AI Rewrite) - via Emergent
EMERGENT_LLM_KEY=your_emergent_llm_key

# App Configuration
APP_BASE_URL=https://your-domain.com

# Mock Mode - Set to true to disable real SMS/Email sending
# When true:
# - Outbound SMS/Email logs as SENT without calling providers
# - Debug endpoints are enabled for testing inbound messages
MOCK_MODE=true
