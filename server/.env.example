# ====================================
# FollowUp Pro v2 - Server Environment
# ====================================

# Database
DATABASE_URL=postgresql://followup_user:followup_pass@localhost:5432/followup_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Expo Push (for server-side push)
EXPO_ACCESS_TOKEN=your_expo_access_token

# App Config
APP_BASE_URL=https://your-domain.com
PUBLIC_BOOKING_BASE_URL=https://your-domain.com/book

# Mock Mode - Set to true for development without external services
MOCK_MODE=true
